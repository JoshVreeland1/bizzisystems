# Copy to .env.local and fill in. .env.local is gitignored.
#
#   cp .env.example .env.local
#
# Both values come from the pilot Supabase project:
#   Supabase → Settings → API
#
# Use the key labelled "anon public". Never the "service_role secret" one.

BIZZI_FIELD_SUPABASE_URL=https://jlhtwuasdsyxqhadytvj.supabase.co
BIZZI_FIELD_ANON_KEY=

# Booking link shown after the contact form is submitted.
#
# Use this long form, not the calendar.app.google short link. The short link
# answers X-Frame-Options: SAMEORIGIN and cannot be embedded, so the site would
# have to send people to a new tab. This URL embeds inline, keeping the whole
# booking flow on bizzisystems.com.
NEXT_PUBLIC_SCHEDULER_URL=https://calendar.google.com/calendar/appointments/schedules/AcZssZ34v2SbTd0sg-lD5ZD3onq606Di6Pc8uq6kss6vboBrTewzVWyJHDYi5rQbfgKf4IE1WVOcTSEf
